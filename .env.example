# Friday local runtime
GOOGLE_CLOUD_CREDS_PATH=D:\path\to\credentials.json
FRIDAY_DEVICE_INDEX=
FRIDAY_CAMERA_INDEX=0

# STT provider. Keep google as production default until Phase 2 benchmark passes.
FRIDAY_STT_PROVIDER=google
FRIDAY_STT_LANGUAGE=th-TH
# Optional experiment only: FRIDAY_STT_PROVIDER=typhoon
# Upstream Typhoon ASR does not officially support Windows yet; validate on the target machine before use.

# Home Assistant — optional read-only Phase 4 integration.
# Create a Long-Lived Access Token in Home Assistant and keep the real value only in local .env.
HOME_ASSISTANT_URL=http://192.168.1.2:8123
HOME_ASSISTANT_TOKEN=replace_with_local_long_lived_access_token
HOME_ASSISTANT_CONNECT_TIMEOUT=5

# LG webOS TV — machine-local only. Never commit real values or paired client keys.
FRIDAY_TV_IP=192.168.1.100
FRIDAY_TV_MAC=00:00:00:00:00:00
FRIDAY_TV_CLIENT_KEY=replace_after_pairing
FRIDAY_TV_BROADCAST_IP=192.168.1.255
FRIDAY_TV_CONNECT_TIMEOUT=5
FRIDAY_TV_BOOT_WAIT=8

# Friday for Hermes Phase 0/1
FRIDAY_FOR_HERMES_MODE=off
HERMES_DASHBOARD_URL=http://127.0.0.1:9119
HERMES_CONNECT_TIMEOUT_SECONDS=5
HERMES_KEEPALIVE_INTERVAL_SECONDS=5
HERMES_SYNC_SOFT_DETACH_SECONDS=20
HERMES_SYNC_HARD_TIMEOUT_SECONDS=60
FRIDAY_CORRELATION_ID_PREFIX=ffh
FRIDAY_HERMES_CONTEXT_BUDGET_TOKENS=2000
FRIDAY_HERMES_CONTEXT_POLICY=minimal
